{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: JG Repuestos",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000", "--no-access-log"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "jinja": false,
      "justMyCode": true
    },
    {
      "name": "React: Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "Crear primer administrador",
      "type": "debugpy",
      "request": "launch",
      "module": "app.cli",
      "args": ["create-admin"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal"
    }
  ]
}
