{
  "version": "2.0.0",
  "tasks": [
    { "label": "Preparar entorno", "type": "process", "command": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/setup.ps1"], "problemMatcher": [] },
    { "label": "Frontend: Vite", "type": "process", "command": "npm.cmd", "args": ["run", "dev"], "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] },
    { "label": "Alembic: migrar", "type": "process", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["-m", "alembic", "upgrade", "head"], "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] },
    { "label": "Backend: Pytest", "type": "process", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["-m", "pytest", "-q"], "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] },
    { "label": "Frontend: verificar", "type": "process", "command": "npm.cmd", "args": ["run", "build"], "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] }
  ]
}
